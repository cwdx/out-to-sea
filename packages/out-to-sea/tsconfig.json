{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "bun",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "electrobun": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun/main": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun/view": [
        "./.hutch/devkit/api/browser/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "electrobun.config.ts",
    "vite.config.ts",
    "golar.config.ts"
  ]
}
